            {
              "id": "5",
              "label": "5",
              "text": "264",
              "image": null
            }
          ],
          "correctOptionId": "4",
          "marks": 1,
          "negativeMarks": 0.25,
          "explanation": "<p><span style=\"font-weight: bolder;\">Calculation</span></p>\n\n<p>&rArr; (33 &times; 17) &minus; 75% of 640 = ? &minus; 201</p>\n\n<p><span style=\"color: rgb(33, 37, 41);\">&rArr; 561 &minus; 75/100&nbsp;&times;&nbsp;640 = ? &minus; 201</span></p>\n\n<p><span style=\"color: rgb(33, 37, 41);\">&rArr; 561 &minus; 3/4 &times;</span><span style=\"color: rgb(33, 37, 41);\">&nbsp;640 = ? &minus; 201</span></p>\n\n<p><span style=\"color: rgb(33, 37, 41);\">&rArr; 561 &minus; 3&nbsp;&times;</span><span style=\"color: rgb(33, 37, 41);\">&nbsp;160 = ? &minus; 201</span></p>\n\n<p>&rArr; 561 &minus; 480 = <span style=\"color: rgb(33, 37, 41);\">? &minus; 201</span></p>\n\n<p><span style=\"color: rgb(33, 37, 41);\">&rArr; 81 =&nbsp;</span><span style=\"color: rgb(33, 37, 41);\">? &minus; 201</span></p>\n\n<p><span style=\"color: rgb(33, 37, 41);\">&rArr; ? = 201 + 81</span></p>\n\n<p><strong>&rArr; ? = 282</strong></p>",
          "topic": "Test"
        },
